# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
FRONTEND_URLS=http://localhost:3000

# PostgreSQL (Neon connection string; keep real credentials out of source control)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
PG_POOL_MAX=10

# Generate two different random secrets, each at least 32 characters long.
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
JWT_ACCESS_LIFETIME=900
JWT_REFRESH_LIFETIME=604800

# Only needed once when creating the first administrator via npm run create-admin.
# Remove ADMIN_PASSWORD from .env after the administrator is created.
# ADMIN_NAME=Your Name
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=replace_with_a_unique_password_at_least_12_characters

# Optional password-reset email configuration
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_google_app_password
